        </mxCell>
        <mxCell id="n12" value="Kredensial DB di /etc/equipment-api.env&lt;br&gt;(chmod 600, tidak masuk Git)" style="text;html=1;align=center;verticalAlign=top;whiteSpace=wrap;fontSize=12;fontColor=#000000;spacingLeft=2;" vertex="1" parent="1">
          <mxGeometry x="400" y="530" width="470" height="80" as="geometry" />
        </mxCell>
