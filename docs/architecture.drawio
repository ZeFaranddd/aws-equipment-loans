        </mxCell>
        <mxCell id="n11" value="&lt;b&gt;Aplikasi Flask + gunicorn :8000&lt;/b&gt;&lt;br&gt;service systemd: equipment-api&lt;br&gt;POST/GET/PUT/DELETE /equipment, GET /health&lt;br&gt;koneksi DB lewat PyMySQL" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;strokeWidth=2;fontColor=#000000;fontSize=13;align=center;verticalAlign=middle;" vertex="1" parent="1">
