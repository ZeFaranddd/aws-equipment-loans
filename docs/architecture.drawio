        <mxCell id="n17" value="RDS hanya bisa dicapai dari dalam VPC.&lt;br&gt;Tanpa NAT Gateway, Load Balancer, atau Multi-AZ&lt;br&gt;(dibatasi Sandbox dan hemat biaya)." style="text;html=1;align=center;verticalAlign=top;whiteSpace=wrap;fontSize=12;fontColor=#000000;spacingLeft=2;" vertex="1" parent="1">
