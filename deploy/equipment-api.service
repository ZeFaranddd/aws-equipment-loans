[Unit]
Description=Equipment Loans API (Flask + gunicorn)
After=network-online.target
Wants=network-online.target

[Service]
User=ec2-user
WorkingDirectory=/opt/equipment-api/src
EnvironmentFile=/etc/equipment-api.env
ExecStart=/opt/equipment-api/venv/bin/gunicorn --bind 0.0.0.0:8000 --workers 2 app:app
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
